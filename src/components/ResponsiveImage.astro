---
// Reproduces Qwik City's `?jsx` image imports: WebP q75 at 200/400/600/800/1200w (never enlarged,
// duplicate widths dropped), `srcset` only (no `src`, no `sizes`), width/height of the largest
// variant, decoding="async" loading="lazy" unless overridden.
import type { ImageMetadata } from "astro";
import type { HTMLAttributes } from "astro/types";
import { getImage } from "astro:assets";
import { metadataOf } from "~/lib/images";

interface Props extends Omit<HTMLAttributes<"img">, "src" | "srcset" | "width" | "height"> {
  src: ImageMetadata;
}

const WIDTHS = [200, 400, 600, 800, 1200];

const { src, ...attrs } = Astro.props;
const { width: originalWidth } = metadataOf(src);
const widths = [...new Set(WIDTHS.map((w) => Math.min(w, originalWidth)))];
const variants = await Promise.all(widths.map((width) => getImage({ src, width, format: "webp", quality: 75 })));
const largest = variants[variants.length - 1];
const srcset = variants.map((v) => `${v.src} ${v.attributes.width}w`).join(", ");
---

<img
  decoding="async"
  loading="lazy"
  {...attrs}
  srcset={srcset}
  width={largest.attributes.width}
  height={largest.attributes.height}
/>
