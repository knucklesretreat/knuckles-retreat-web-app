---
import Icon from "~/components/Icon.astro";
import LogoSymbol from "~/components/LogoSymbol.astro";
import styles from "./footer.module.css";
---

<footer>
  <div class={styles.footer_sec}>
    <div class={styles.footer_content}>
      <div class:list={[styles.sec, styles.about]}>
        <div class={styles.logo}>
          <LogoSymbol class={styles.logo_symbol} />
          <h2>Knuckles Retreat</h2>
          <h3>-RECONNECT WITH NATURE-</h3>
        </div>
        <ul class={styles.social_icons}>
          <li><a href="https://web.facebook.com/profile.php?id=61554911975425" target="_blank" aria-label="Knuckles Retreat facebook page link icon"><i><Icon name="IoLogoFacebook" /></i></a></li>
          <li><a href="https://www.instagram.com/knucklesretreat" target="_blank" aria-label="Knuckles Retreat instagram account link icon"><i><Icon name="IoLogoInstagram" /></i></a></li>
          <li><a href="https://www.youtube.com/@KnucklesRetreat" target="_blank" aria-label="Knuckles Retreat youtube channel link icon"><i><Icon name="IoLogoYoutube" /></i></a></li>
        </ul>
      </div>

      <div class:list={[styles.sec, styles.quicklinks]}>
        <h2>Support</h2>
        <ul>
          <li><a href="/inquiry">Inquire</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/privacy-policy">Privacy Policy</a></li>
          <li><a href="/terms-and-conditions">Terms & Conditions</a></li>
        </ul>
      </div>

      <div class:list={[styles.sec, styles.quicklinks]}>
        <h2>Navigate</h2>
        <ul>
          <li><a href="/#home">Home</a></li>
          <li><a href="/#gallery">Gallery</a></li>
          <li><a href="/#explore">Explore</a></li>
          <li><a href="/accommodation">Accommodation</a></li>
        </ul>
      </div>

      <div class:list={[styles.sec, styles.contact]}>
        <h2>Contact Us</h2>
        <ul class={styles.info}>
          <li><i><Icon name="IoCallSolid" /></i><a href="tel:+94774410767">+94 77 441 0767</a></li>
          <li><i><Icon name="IoMailSolid" /></i><a href="mailto:inquiries@knucklesretreat.com">inquiries@knucklesretreat.com</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class={styles.copyright}>
    Copyright © 2025 - Knuckles Retreat. All Rights Reserved.
  </div>
</footer>
