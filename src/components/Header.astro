---
import Icon from "~/components/Icon.astro";
import LogoSymbol from "~/components/LogoSymbol.astro";
import { reencodedUrl } from "~/lib/images";
import BgPatternSrc from "~/media/pattern1.webp";
import styles from "./header.module.css";

const BgPattern = await reencodedUrl(BgPatternSrc);
---

<header class={styles.header}>
  <div class={styles.logo_wrapper}>
    <LogoSymbol class={styles.logo_symbol} />
    <h4>Knuckles Retreat</h4>
    <h5>-RECONNECT WITH NATURE-</h5>
  </div>
  <div class={styles.nav_bar}>
    <div></div>
    <div class:list={["navigation", styles.navigation]}>
      <div class={styles.nav_items}>
        <picture>
          <source media="(max-width: 460px)" srcset={BgPattern} />
          <img class={styles.bg_pattern} alt="flower pattern" height={20} width={20} />
        </picture>
        <i class={styles.nav_close_btn}><Icon name="MatCloseOutlined" /></i>
        <a href="/#home"><i><Icon name="MatHomeOutlined" /></i>Home</a>
        <a href="/accommodation"><i><Icon name="MatKingBedOutlined" /></i>Accommodation</a>
        <a href="/#gallery"><i><Icon name="MatPhotoLibraryOutlined" /></i>Gallery</a>
        <a href="/#explore"><i><Icon name="MatExploreOutlined" /></i>Explore</a>
        <a href="/#contact"><i><Icon name="MatMailOutlined" /></i>Contact</a>
      </div>
    </div>
    <i class={styles.nav_menu_btn}><Icon name="MatBlurOnOutlined" /></i>
  </div>
</header>
