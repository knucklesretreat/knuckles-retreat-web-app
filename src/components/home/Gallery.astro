---
import ResponsiveImage from "~/components/ResponsiveImage.astro";
import { reencodedUrl } from "~/lib/images";
import ImgOne from "~/media/gallery/img1.webp";
import ImgTwo from "~/media/gallery/img2.webp";
import ImgThree from "~/media/gallery/img3.webp";
import ImgFour from "~/media/gallery/img4.webp";
import ImgFive from "~/media/gallery/img5.webp";
import ImgSix from "~/media/gallery/img6.webp";
import ImgSeven from "~/media/gallery/img7.webp";
import BgPattern from "~/media/pattern1.webp";
import styles from "./gallery.module.css";

const images = await Promise.all([ImgOne, ImgTwo, ImgThree, ImgFour, ImgFive, ImgSix, ImgSeven].map(reencodedUrl));
---

<section id="gallery" class={styles.gallery}>
  <ResponsiveImage src={BgPattern} loading="lazy" alt="flower pattern" class:list={[styles.bg_img, styles.top_img]} />
  <ResponsiveImage src={BgPattern} loading="lazy" alt="flower pattern" class:list={[styles.bg_img, styles.bottom_img]} />

  <div class={styles.gallery_grid}>
    <div class={styles.text_content}>
      <h2>Gallery</h2>
      <p>
        Moments of joy, adventure, and relaxation. A testament to the unforgettable
        memories created at Knuckles Retreat.
      </p>
    </div>

    <div class={styles.grid_container}>
      {images.map((img) => <div class={styles.grid_item} style={`background-image:url(${img})`}></div>)}
    </div>
  </div>
</section>
