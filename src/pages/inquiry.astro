---
import countrylist from "~/data/country-list.json";
import BaseLayout from "~/layouts/BaseLayout.astro";
import styles from "~/styles/inquiry.module.css";

const salutations = ["Mr.", "Mrs.", "Miss.", "Dr.", "Prof.", "Ven."];
// Qwik computed this per request; a static build freezes it at build time, so the page script (Phase 3)
// sets it again on load. This value is only the no-JS fallback.
const today = new Date().toISOString().split("T")[0];
---

<BaseLayout
  title="Knuckles Retreat | Inquire"
  description="Have a question about our accommodations, services, or special requests? We're here to help. Fill out the form below with your details and inquiries, and our dedicated team will get back to you with the information you need."
>
  <section class={styles.inquiry_sec}>
    <div class={styles.inquiry_content}>
      <div class={styles.header_content}>
        <h1>Inquire with Knuckles Retreat</h1>
        <p>Have a question about our accommodations, services, or special requests? We're here to help. Fill out the form below with your details and inquiries,
          and our dedicated team will get back to you with the information you need.</p>
      </div>
      <div class={styles.form_sec}>
        <h2>Reservation Request Form</h2>

        <form>

          <div class={styles.form_row}>
            <div class={styles.salutation}>
              <label for="salutation">Salutation <span>*</span></label>
              <select id="salutation" name="salutation" value="Mr.">
                {salutations.map((sal) => <option value={sal}>{sal}</option>)}
              </select>
            </div>

            <div class={styles.fname}>
              <label for="fname">Full Name <span>*</span></label>
              <input type="text" id="fname" name="fullname" placeholder="Full Name" value="" />
            </div>
          </div>

          <div class={styles.form_row}>
            <div class={styles.country}>
              <label for="country">Country <span>*</span></label>
              <select id="country" name="country" value="">
                <option>Please select</option>
                {countrylist.map((cntry) => <option value={cntry.name}>{cntry.name}</option>)}
              </select>
            </div>

            <div class={styles.telephone}>
              <label for="telephone">Telephone <span>*</span></label>
              <input type="text" id="telephone" name="telephone" placeholder="Telephone" value="" />
            </div>
          </div>

          <div class={styles.form_row}>
            <div class={styles.arrival}>
              <label for="arrival">Arrival <span>*</span></label>
              <input type="date" id="arrival" name="arrival" placeholder="Select date" min={today} value="" />
            </div>

            <div class={styles.departure}>
              <label for="departure">Departure <span>*</span></label>
              <input type="date" id="departure" name="departure" placeholder="Select date" value="" />
            </div>
          </div>

          <div class={styles.form_row}>
            <div class={styles.email}>
              <label for="email">Email <span>*</span></label>
              <input type="text" id="email" name="email" placeholder="Email" value="" />
            </div>
            <div class={styles.guests}>
              <label for="guestcount">Number of Guests <span>*</span></label>
              <input type="number" min={1} max={30} id="guestcount" name="guestcount" placeholder="1" value="1" />
            </div>
          </div>

          <div class={styles.form_row}>
            <div class={styles.otherinfo}>
              <label for="otherinfo">Other Information</label>
              <textarea name="otherinfo" id="otherinfo"></textarea>
            </div>
          </div>

          <div class="g-recaptcha" id="kr-g-recaptcha" data-sitekey="6LfqVD4pAAAAAByXb5ErD4k81KielZ8Ybz4PRw8K"></div>
          <br />

          <div class={styles.btn_row}>
            <button class={styles.submit_btn} type="submit">Submit</button>
            <span>RESET</span>
          </div>

        </form>
      </div>
    </div>
  </section>
</BaseLayout>
