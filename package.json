{
  "name": "knuckles-retreat-web-app",
  "description": "Knuckles Retreat website (Astro, static)",
  "engines": {
    "node": ">=22.23.4"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --port 4173",
    "preview.cf": "wrangler dev --port 8787",
    "check": "astro check",
    "lint": "eslint \"src/**/*.ts\"",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "deploy": "astro build && wrangler deploy"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@qwik.dev/partytown": "^0.11.2",
    "@types/node": "20.14.11",
    "@typescript-eslint/eslint-plugin": "7.16.1",
    "@typescript-eslint/parser": "7.16.1",
    "astro": "7.3.8",
    "esbuild": "0.28.2",
    "eslint": "8.57.0",
    "prettier": "3.3.3",
    "typescript": "5.4.5",
    "wrangler": "4.154.0"
  }
}
